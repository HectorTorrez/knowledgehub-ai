  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Tenant comes from the route; the body cannot select an organization",
        "SessionGuard verifies the JWT and the live session row",
        "Membership is re-read on every tenant request; foreign ids return 404",
        "CSRF double-submit protects unsafe cookie requests"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ingestion",
      "items": [
        "API signs a presigned PUT; bytes travel browser → object storage",
        "Verification checks ≤25 MiB, declared vs real type, and PDF/UTF-8 signature",
        "Generation increments; a leased job extracts, chunks 1600/320, embeds 1536-d",
        "Publish is fenced by lease + generation; retries back off to 60 s, max 5"
      ]
    },
    {
      "dot": "violet",
      "title": "Answering",
      "items": [
        "Query embedded once; pgvector top-k filtered by org, READY, generation",
        "8 sources / 24k chars; minimum similarity 0.20; recent-document catalog",
        "Model returns a JSON claim contract; server validates every citation marker",
        "Persist only on success; NDJSON streams status → delta → citations"
      ]
    },
    {
      "dot": "amber",
      "title": "State & providers",
      "items": [
        "Postgres holds tenant data, extracted pages, chunks, jobs, facts, usage",
        "Redis shares rate windows; without it the fallback is per-process",
        "Prompts carry the question, prior turns, passages, and document titles",
        "No OCR: image-only PDFs fail as NO_EXTRACTABLE_TEXT"
      ]
    }
  ]
