{
  "extends": "@knowledgehub/tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "eval/**/*.ts",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
