// KnowledgeHub AI persistence schema.
//
// The connection URL is intentionally not defined here: it is supplied at
// runtime by the API (see `src/prisma/prisma.service.ts`) and to the Prisma CLI
// by `prisma.config.ts`, both reading `DATABASE_URL`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// An authenticated account. Deliberately not tied to an organization: users
/// will eventually belong to many organizations, so tenancy is modeled
/// separately from identity.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Normalized (trimmed, lower-cased) email. Uniqueness is enforced on the
  /// normalized form; see `src/users/email.ts`.
  email String @unique

  passwordHash String
  firstName    String
  lastName     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    AuthSession[]
  memberships Membership[]
  documents   Document[]
  answers     Answer[]
}

/// A single login on a single device. This is the unit of revocation: revoking
/// a session immediately invalidates that device's access tokens and its
/// refresh-token chain, without affecting the user's other sessions.
model AuthSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Absolute session lifetime. Independent of individual refresh tokens.
  expiresAt DateTime

  /// Set when the session is revoked (logout, reuse detected, admin action).
  revokedAt DateTime?

  /// Updated when a refresh token is successfully rotated.
  lastUsedAt DateTime?

  /// Device information captured at session creation for the audit trail.
  userAgent String?
  ipAddress String?

  refreshTokens RefreshToken[]

  @@index([userId])
}

/// One issued opaque refresh token. Tokens are single-use: on refresh the
/// presented token is marked `usedAt` and a new row is issued. Keeping used rows
/// (until they expire) is what makes reuse detection possible: presenting an
/// already-used token is treated as theft and revokes the whole session.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// SHA-256 (or stronger) hash of the opaque token. The plaintext token is
  /// only ever returned to the client, never stored.
  tokenHash String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime

  /// Set the moment the token is exchanged during rotation. A non-null value
  /// means "already used" and therefore a reuse attempt if presented again.
  usedAt DateTime?

  @@index([sessionId])
}

/// A user's role within a single organization. Deliberately minimal for now:
/// the finer-grained permissions model is intentionally out of scope.
enum MembershipRole {
  OWNER
  MEMBER
}

/// A tenant. Identity is modeled separately (see `User`): an organization is
/// joined through memberships rather than embedded on the user.
///
/// INVARIANT — every organization must retain at least one OWNER membership.
/// This is enforced by application logic in `OrganizationsService`, not by a
/// database constraint, so it is only as strong as the writes that respect it:
/// every membership mutation that can reduce the owner count must acquire the
/// organization row with `SELECT ... FOR UPDATE` before it reads or changes
/// memberships, and must revalidate the actor's OWNER role inside that same
/// transaction.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  documents   Document[]
  answers     Answer[]
  tenantUsage TenantUsage[]
}

/// Links a user to an organization with a role. The [userId, organizationId]
/// pair is unique, so a user belongs to a given organization at most once.
model Membership {
  id String @id @default(uuid()) @db.Uuid

  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role MembershipRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

/// Processing lifecycle of a document: PENDING once registered and awaiting
/// upload, PROCESSING while its contents are extracted and embedded, then READY
/// on success or FAILED on error.
enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Which stage a FAILED document failed in. Null unless `status` is FAILED.
enum DocumentFailureKind {
  VERIFICATION
  PROCESSING
}

/// Outcome of a persisted answer. `insufficient_evidence` is a successful
/// outcome where the retrieved sources could not support an answer.
enum AnswerStatus {
  answered
  insufficient_evidence
}

/// Queue state of a durable document processing job. QUEUED and CLAIMED are
/// active (a document in PROCESSING has exactly one); SUCCEEDED and FAILED are
/// terminal.
enum ProcessingJobState {
  QUEUED
  CLAIMED
  SUCCEEDED
  FAILED
}

/// A file registered within a single organization.
///
/// OWNERSHIP — a document belongs to its organization, not to the user who
/// uploaded it. `uploadedById` is provenance only: it is nullable so a document
/// survives its uploader's deletion, and it never scopes access. Every read and
/// write is scoped by `organizationId`, which is why the organization relation
/// cascades but the uploader relation does not.
///
/// The file coordinates (`originalFileName`, `contentType`, `sizeBytes`) and the
/// verified `storageKey` stay null until an upload is verified. Only
/// `uploadStorageKey` is set when a presigned upload URL is issued.
model Document {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  title String

  status DocumentStatus @default(PENDING)

  /// Increments exactly once per successful verification. It is the immutable
  /// processing identity of the verified bytes and what a processing job targets.
  generation Int @default(0)

  /// Client-writable staging key for the most recently issued upload URL. Each
  /// new upload URL supersedes it. The client can overwrite the object it names,
  /// so it is never processed.
  uploadStorageKey String?

  /// Content type the most recent upload URL was signed for. Verification
  /// compares the stored object's real type against it; null until a URL is
  /// issued (and for rows migrated from before verification existed).
  expectedContentType String?

  /// Server-controlled key of the verified object. Set only after verification
  /// promotes the staging object; never handed to a client. Not exposed through
  /// the public API. Later phases read this key, not `uploadStorageKey`.
  storageKey String?

  originalFileName String?
  contentType      String?
  sizeBytes        Int?

  /// Sanitized reason populated only when `status` is FAILED.
  failureReason String?

  /// Which stage produced `failureReason`. Null unless `status` is FAILED.
  failureKind DocumentFailureKind?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processingJobs DocumentProcessingJob[]
  extractions    DocumentExtraction[]
  chunks         DocumentChunk[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

/// Durable unit of document processing work, created atomically with the
/// verification that promotes a document to PROCESSING.
///
/// IDENTITY — a job targets exactly one verified generation: `documentGeneration`
/// plus the `verifiedStorageKey` snapshot. It never switches objects.
///
/// CLAIMS — `leaseId` is minted fresh on every claim and is the authority for the
/// claiming worker's writes; a reclaimed job gets a new `leaseId`, so a stalled
/// worker cannot publish after losing its lease.
model DocumentProcessingJob {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  organizationId String @db.Uuid

  documentGeneration Int
  verifiedStorageKey String

  state ProcessingJobState @default(QUEUED)

  attempt       Int      @default(0)
  maxAttempts   Int
  nextAttemptAt DateTime @default(now())

  leaseId        String?   @db.Uuid
  leaseExpiresAt DateTime?
  claimedBy      String?

  /// Sanitized internal detail for operators. Never part of the public API.
  lastError String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@unique([documentId], where: raw("state IN ('QUEUED', 'CLAIMED')"))
  @@index([nextAttemptAt, id], where: raw("state = 'QUEUED'"))
  @@index([documentId, documentGeneration])
  @@index([organizationId, state])
}

/// Extracted text published for exactly one verified document generation.
///
/// IMMUTABILITY — the [documentId, documentGeneration] pair is unique: a
/// generation is extracted once, and a stale or duplicate execution cannot
/// overwrite an accepted result. The publishing write revalidates the current
/// job lease and the document generation in the same transaction, so only the
/// current lease holder can create the row.
///
/// `pages` preserves the page boundary of the source document
/// (`[{ pageNumber, content }, …]`) so later phases can attribute a chunk to the
/// page it came from; `characterCount` is the total across pages.
model DocumentExtraction {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  organizationId String @db.Uuid

  documentGeneration Int
  verifiedStorageKey String

  pages          Json
  pageCount      Int
  characterCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, documentGeneration])
  @@index([organizationId])
}

/// A contiguous slice of one page's extracted text, addressed by document
/// generation, produced by the chunking phase.
///
/// IDENTITY — [documentId, documentGeneration, chunkIndex] is unique, so a retry
/// of a generation replaces its chunks rather than appending duplicates, and a
/// stale execution can only ever touch its own generation.
model DocumentChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  organizationId String @db.Uuid

  documentGeneration Int

  /// 1-based page the chunk was taken from. A chunk never spans two pages.
  pageNumber Int

  /// 0-based order of the chunk within its generation.
  chunkIndex Int

  content        String
  characterCount Int

  /// 1536-dimensional embedding from `EMBEDDING_MODEL` (OpenAI
  /// `text-embedding-3-small`). Declared `Unsupported` because Prisma has no
  /// vector type: it is excluded from the generated client and read or written
  /// only through raw SQL. The database enforces NOT NULL and the dimension.
  embedding Unsupported("vector(1536)")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, documentGeneration, chunkIndex])
  @@index([organizationId])
  @@index([documentId, documentGeneration])
}

/// A persisted answer to a question, owned by the organization it was asked in.
///
/// OWNERSHIP — an answer belongs to its organization, not to the user who asked
/// it. `askedById` is provenance only: it is nullable so an answer survives its
/// asker's deletion, and it never scopes access. Every read and write is scoped
/// by `organizationId`.
///
/// `citations` is a JSON array of the `AnswerCitation` shape returned to the
/// client, so a later read reconstructs the full answer without re-deriving it.
model Answer {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  askedById String? @db.Uuid
  askedBy   User?   @relation(fields: [askedById], references: [id], onDelete: SetNull)

  question String
  status   AnswerStatus

  answer    String?
  citations Json

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// A persisted daily usage counter for a tenant, keyed by organization, kind,
/// and the UTC day the usage falls in. Used to enforce per-tenant quotas that
/// survive restarts; the counter is scoped by organization so a tenant can never
/// read or consume another tenant's budget.
model TenantUsage {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind        String
  periodStart DateTime
  count       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, kind, periodStart])
  @@index([organizationId])
}
