// KnowledgeHub AI persistence schema.
//
// The connection URL is intentionally not defined here: it is supplied at
// runtime by the API (see `src/prisma/prisma.service.ts`) and to the Prisma CLI
// by `prisma.config.ts`, both reading `DATABASE_URL`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// An authenticated account. Deliberately not tied to an organization: users
/// will eventually belong to many organizations, so tenancy is modeled
/// separately from identity.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Normalized (trimmed, lower-cased) email. Uniqueness is enforced on the
  /// normalized form; see `src/users/email.ts`.
  email String @unique

  passwordHash String
  firstName    String
  lastName     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    AuthSession[]
  memberships Membership[]
  documents   Document[]
}

/// A single login on a single device. This is the unit of revocation: revoking
/// a session immediately invalidates that device's access tokens and its
/// refresh-token chain, without affecting the user's other sessions.
model AuthSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Absolute session lifetime. Independent of individual refresh tokens.
  expiresAt DateTime

  /// Set when the session is revoked (logout, reuse detected, admin action).
  revokedAt DateTime?

  /// Updated when a refresh token is successfully rotated.
  lastUsedAt DateTime?

  /// Device information captured at session creation for the audit trail.
  userAgent String?
  ipAddress String?

  refreshTokens RefreshToken[]

  @@index([userId])
}

/// One issued opaque refresh token. Tokens are single-use: on refresh the
/// presented token is marked `usedAt` and a new row is issued. Keeping used rows
/// (until they expire) is what makes reuse detection possible: presenting an
/// already-used token is treated as theft and revokes the whole session.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// SHA-256 (or stronger) hash of the opaque token. The plaintext token is
  /// only ever returned to the client, never stored.
  tokenHash String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime

  /// Set the moment the token is exchanged during rotation. A non-null value
  /// means "already used" and therefore a reuse attempt if presented again.
  usedAt DateTime?

  @@index([sessionId])
}

/// A user's role within a single organization. Deliberately minimal for now:
/// the finer-grained permissions model is intentionally out of scope.
enum MembershipRole {
  OWNER
  MEMBER
}

/// A tenant. Identity is modeled separately (see `User`): an organization is
/// joined through memberships rather than embedded on the user.
///
/// INVARIANT — every organization must retain at least one OWNER membership.
/// This is enforced by application logic in `OrganizationsService`, not by a
/// database constraint, so it is only as strong as the writes that respect it:
/// every membership mutation that can reduce the owner count must acquire the
/// organization row with `SELECT ... FOR UPDATE` before it reads or changes
/// memberships, and must revalidate the actor's OWNER role inside that same
/// transaction.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  documents   Document[]
}

/// Links a user to an organization with a role. The [userId, organizationId]
/// pair is unique, so a user belongs to a given organization at most once.
model Membership {
  id String @id @default(uuid()) @db.Uuid

  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role MembershipRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

/// Processing lifecycle of a document: PENDING once registered and awaiting
/// upload, PROCESSING while its contents are extracted and embedded, then READY
/// on success or FAILED on error.
enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// A file registered within a single organization.
///
/// OWNERSHIP — a document belongs to its organization, not to the user who
/// uploaded it. `uploadedById` is provenance only: it is nullable so a document
/// survives its uploader's deletion, and it never scopes access. Every read and
/// write is scoped by `organizationId`, which is why the organization relation
/// cascades but the uploader relation does not.
///
/// The file coordinates (`originalFileName`, `contentType`, `sizeBytes`) and the
/// verified `storageKey` stay null until an upload is verified. Only
/// `uploadStorageKey` is set when a presigned upload URL is issued.
model Document {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  title String

  status DocumentStatus @default(PENDING)

  /// Client-writable staging key for the most recently issued upload URL. Each
  /// new upload URL supersedes it. The client can overwrite the object it names,
  /// so it is never processed.
  uploadStorageKey String?

  /// Content type the most recent upload URL was signed for. Verification
  /// compares the stored object's real type against it; null until a URL is
  /// issued (and for rows migrated from before verification existed).
  expectedContentType String?

  /// Server-controlled key of the verified object. Set only after verification
  /// promotes the staging object; never handed to a client. Not exposed through
  /// the public API.
  storageKey String?

  originalFileName String?
  contentType      String?
  sizeBytes        Int?

  /// Sanitized reason populated only when `status` is FAILED.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}
