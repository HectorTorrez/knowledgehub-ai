# Local development configuration for the API.
# Copy this file to `.env` and adjust values as needed. Never commit `.env`.

# Port the API listens on.
PORT=3001

# Comma-separated list of frontend origins allowed to call the API.
# Credentials are enabled, so an explicit origin list is required (no wildcard).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma (CLI and runtime).
# Must match the Postgres service defined in the repository-root `compose.yaml`.
# Use 127.0.0.1 (not `localhost`) because the container port is bound to IPv4
# 127.0.0.1 only; `localhost` may resolve to ::1 and fail to connect.
DATABASE_URL=postgresql://knowledgehub:change-me-local-development@127.0.0.1:5432/knowledgehub?schema=public

# Signing secret for access tokens. Required, minimum 32 characters.
# Generate a strong, unique value per environment, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

# Access-token lifetime. Keep it short (e.g. 15m, 1h).
JWT_ACCESS_TTL=15m

# Refresh-token and session lifetime, in days. Short by design for the MVP.
REFRESH_TOKEN_TTL_DAYS=7

# Cookie behavior for auth cookies. `COOKIE_SECURE` defaults to true in
# production; set it explicitly to override. `COOKIE_SAMESITE` is lax by
# default. `COOKIE_DOMAIN` is optional (omit for host-only cookies).
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
