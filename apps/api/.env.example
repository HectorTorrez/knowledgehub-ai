# Local development configuration for the API.
# Copy this file to `.env` and adjust values as needed. Never commit `.env`.

# Port the API listens on.
PORT=3001

# Comma-separated list of frontend origins allowed to call the API.
# Credentials are enabled, so an explicit origin list is required (no wildcard).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma (CLI and runtime).
# Must match the Postgres service defined in the repository-root `compose.yaml`.
# Use 127.0.0.1 (not `localhost`) because the container port is bound to IPv4
# 127.0.0.1 only; `localhost` may resolve to ::1 and fail to connect.
DATABASE_URL=postgresql://knowledgehub:change-me-local-development@127.0.0.1:5432/knowledgehub?schema=public

# Signing secret for access tokens. Required, minimum 32 characters.
# Generate a strong, unique value per environment, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

# Access-token lifetime. Keep it short (e.g. 15m, 1h).
JWT_ACCESS_TTL=15m

# Refresh-token and session lifetime, in days. Short by design for the MVP.
REFRESH_TOKEN_TTL_DAYS=7

# Cookie behavior for auth cookies. `COOKIE_SECURE` defaults to true in
# production; set it explicitly to override. `COOKIE_SAMESITE` is lax by
# default. `COOKIE_DOMAIN` is optional (omit for host-only cookies).
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Browser (cookie-based) authentication is opt-in. The API default is `false`,
# and it must stay `false` in production unless a CSRF secret is configured.
# Local development sets it to `true` below so the SPA authenticates with
# cookies; the frontend must then echo the csrf_token cookie in the
# `X-CSRF-Token` header on every unsafe request. Set to `false` to exercise
# bearer-only clients locally.
BROWSER_AUTH_ENABLED=true

# Dedicated secret used to sign CSRF tokens (HMAC-SHA256). Required whenever
# BROWSER_AUTH_ENABLED=true (startup fails otherwise). Must be at least 32
# characters; generate a unique value per environment, e.g.: openssl rand -base64 48
CSRF_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

STORAGE_BUCKET=knowledgehub-documents
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_TTL_SECONDS=900
STORAGE_ACCESS_KEY_ID=knowledgehub
STORAGE_SECRET_ACCESS_KEY=change-me-local-development-minio-secret

# Document processing worker. Disabled by default so the API never consumes the
# queue implicitly; set PROCESSING_WORKER_ENABLED=true to run it in-process and
# extract queued documents. Intervals are in milliseconds.
PROCESSING_WORKER_ENABLED=false
PROCESSING_POLL_INTERVAL_MS=2000
PROCESSING_LEASE_RENEWAL_INTERVAL_MS=20000
PROCESSING_RECOVERY_INTERVAL_MS=30000

# Embeddings. The provider is OpenAI; OPENAI_API_KEY is required whenever
# PROCESSING_WORKER_ENABLED=true or ANSWERS_ENABLED=true (startup fails
# otherwise). EMBEDDING_DIMENSIONS must equal the stored vector dimension
# (1536); a mismatch fails at startup so the provider, configuration, and
# database column can never disagree.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000

# Grounded answers. Disabled by default so the API never exposes an answer
# endpoint that cannot reach a completion provider. Set ANSWERS_ENABLED=true to
# mount answer generation; OPENAI_API_KEY is then required at startup (the API
# fails fast otherwise) and the endpoint returns 503 while it is disabled.
# The provider is the same OpenAI account as embeddings and shares
# OPENAI_BASE_URL. The default model is conservative and config-only: switching
# models is an environment change, not a code change. ANSWER_TIMEOUT_MS bounds
# one completion; ANSWER_MAX_OUTPUT_TOKENS caps the completion size (1-4096);
# the remaining values bound the assembled context (sources 1-20, characters
# 1000-100000, cosine similarity 0-1).
ANSWERS_ENABLED=false
ANSWER_MODEL=gpt-4.1-mini
ANSWER_TIMEOUT_MS=30000
ANSWER_MAX_OUTPUT_TOKENS=700
ANSWER_MAX_SOURCES=8
ANSWER_CONTEXT_MAX_CHARS=24000
ANSWER_MIN_SIMILARITY=0.2

# Rate limiting (requests per minute, per key) and the per-tenant daily answer
# quota. Login is keyed by IP; search and answers are keyed by organization
# (tenant) with answers additionally capped per user. The answer quota is
# persisted in the database so it survives restarts.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_ANSWER_USER_PER_MINUTE=5
RATE_LIMIT_ANSWER_TENANT_PER_MINUTE=20
QUOTA_ANSWER_DAILY=1000


# The answer evaluation harness is opt-in and excluded from the normal test
# suites. It uses the real configured providers, so it needs a real
# OPENAI_API_KEY exported in the process environment plus ANSWERS_ENABLED=true:
#   OPENAI_API_KEY=sk-... ANSWERS_ENABLED=true pnpm test:answers:eval
# The test setup otherwise supplies a placeholder OPENAI_API_KEY, and the
# harness refuses to run when it detects that placeholder. A key placed only in
# this file is not enough for the evaluation. Never commit a real key.
