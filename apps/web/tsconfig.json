{
  "extends": "@knowledgehub/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "vitest/globals"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".output", ".tanstack"]
}
