# Base origin of the KnowledgeHub API.
#
# The frontend calls this origin directly with `credentials: "include"`, so:
#   - the API must list this frontend origin in `CORS_ORIGIN`;
#   - the API must run with `BROWSER_AUTH_ENABLED=true` and a `CSRF_SECRET`;
#   - the value must be an absolute http(s) URL with no path beyond the origin
#     (the app validates this at startup and rejects anything else).
#
# Local development: the API listens on port 3001, the web app on 3000.
VITE_API_BASE_URL=http://localhost:3001
