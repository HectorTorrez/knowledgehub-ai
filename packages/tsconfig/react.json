{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "KnowledgeHub React (Vite / TanStack Start)",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "useDefineForClassFields": true,
    "allowJs": true,
    "noEmit": true
  }
}
