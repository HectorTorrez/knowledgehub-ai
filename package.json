{
  "name": "knowledgehub-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:health": "docker compose ps postgres",
    "db:logs": "docker compose logs -f postgres",
    "storage:up": "docker compose up -d minio minio-init",
    "storage:down": "docker compose stop minio",
    "storage:health": "docker compose ps minio",
    "storage:logs": "docker compose logs -f minio",
    "cache:up": "docker compose up -d redis",
    "cache:down": "docker compose stop redis",
    "cache:health": "docker compose ps redis",
    "db:migrate": "pnpm --filter @knowledgehub/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @knowledgehub/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @knowledgehub/api db:migrate:status",
    "db:reset": "pnpm --filter @knowledgehub/api db:reset",
    "db:studio": "pnpm --filter @knowledgehub/api db:studio"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
