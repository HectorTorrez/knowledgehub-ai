# Local infrastructure configuration for Docker Compose (Postgres).
#
# Copy this file to `.env` in the repository root:
#   cp .env.example .env
#
# These are local development values only. Never commit `.env` and never put
# real credentials here.

# PostgreSQL credentials and database name used by compose.yaml.
POSTGRES_USER=knowledgehub
POSTGRES_PASSWORD=change-me-local-development
POSTGRES_DB=knowledgehub

# Host port Postgres is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
